# Copie para .env e ajuste. O .env NUNCA vai para o Git.

NODE_ENV=development
PORT=3333
HOST=0.0.0.0

# ---------------------------------------------------------------- BANCO
#
# São duas URLs: DATABASE_URL é usada em tempo de execução e DIRECT_URL pelas
# migrations. Em Postgres local as duas são iguais; no Supabase, não.
#
# a) PostgreSQL local (portátil, `npm run hml:db start`):
DATABASE_URL="postgresql://impakto:impakto@localhost:5433/impakto?schema=public"
DIRECT_URL="postgresql://impakto:impakto@localhost:5433/impakto?schema=public"
#
# b) Supabase — copie de Project Settings › Database › Connection string:
#    DATABASE_URL = "Transaction pooler"  (porta 6543) + &pgbouncer=true
#    DIRECT_URL   = "Direct connection"   (porta 5432)
#
# DATABASE_URL="postgresql://postgres.<ref>:<SENHA>@aws-0-<regiao>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
# DIRECT_URL="postgresql://postgres:<SENHA>@db.<ref>.supabase.co:5432/postgres"
#
# A senha do banco NÃO é a senha da sua conta Supabase: é a do projeto, em
# Settings › Database › Database password.

# Segredo de assinatura do JWT — mínimo de 32 caracteres.
# Gere um por ambiente:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-este-valor-por-um-segredo-de-48-bytes-aleatorios"
JWT_EXPIRACAO=15m
REFRESH_EXPIRACAO_HORAS=12

# DV2 — origens permitidas, separadas por vírgula. Rede interna por padrão.
CORS_ORIGENS=http://localhost:5173

# R12 — fuso da portaria. Não trocar sem entender a seção 4.5 do levantamento.
TZ_PORTARIA=America/Sao_Paulo

LOG_LEVEL=info

# Senha do administrador inicial, usada só pelo seed. Sem ela, nenhum usuário
# é criado — `admin`/`admin` do desktop não pode chegar à produção.
ADMIN_SENHA_INICIAL=
